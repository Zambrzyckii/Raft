# Copy to .env and adjust. Compose reads it for the containers, dotnet run reads it for the host cluster.
POSTGRES_DB=raft
POSTGRES_USER=raft
POSTGRES_PASSWORD=raft
POSTGRES_PORT=5434

# Used by dotnet run on the host. The container gets its own connection string from compose.
ConnectionStrings__Primes=Host=localhost;Port=5434;Database=raft;Username=raft;Password=raft

# Optional. Where the nodes bind. Unset keeps them on their localhost identity, compose sets * inside the container.
# BindHost=*
